# ==============================================================================
# ONE-DAY CITY PLANNER — ENVIRONMENT CONFIGURATION
# ==============================================================================
# All keys must remain strictly server-side.
# Never expose secrets through NEXT_PUBLIC_* variables.
# ==============================================================================

# Groq API Key (Confirmed Free-Tier)
# Get your free key at: https://console.groq.com/keys
# Free tier limits: 30 RPM, 8K TPM, 200K TPD, 1,000 Requests/Day on Groq's current free plan for qwen/qwen3.8-27b (no billing required)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Name (Default: qwen/qwen3.8-27b)
# Configurable via environment variable
GROQ_MODEL=qwen/qwen3.8-27b

# Geoapify API Key (Free-Tier)
# Get your free key at: https://www.geoapify.com/
# Free-tier quota: 3,000 requests/credits per day (No credit card required)
# Used for: Geocoding, Places Search, Directional Routing, Route Matrix
GEOAPIFY_API_KEY=your_geoapify_api_key_here
